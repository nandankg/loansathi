# Copy this file to .env on the server and fill in real values.
# .env is gitignored — never commit secrets.

# Environment: 'production' silences error display, 'development' shows tracebacks
APP_ENV=production

# Site
BASE_URL=https://yourdomain.in
CONTACT_PHONE=+919876543210
CONTACT_PHONE_DISPLAY=+91 98765 43210
CONTACT_WHATSAPP=919876543210
CONTACT_EMAIL=hello@yourdomain.in
CONTACT_LEAD_INBOX=leads@yourdomain.in

# SMTP (Hostinger defaults: smtp.hostinger.com, port 465 SSL or 587 TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=leads@yourdomain.in
SMTP_PASS=your-mailbox-password
SMTP_SECURE=tls
SMTP_FROM=leads@yourdomain.in

# Search-console verification (optional)
GSC_VERIFICATION=
BING_VERIFICATION=

# One-shot deploy helper: set this to a long random string, then visit
# /setup.php?key=THAT_VALUE to install the DB schema and seed the first admin.
# Delete public/setup.php from the server once setup is complete.
SETUP_KEY=
