# Copy this file to .env on the server and fill in real values.
# .env is gitignored — never commit secrets.

# Environment: 'production' silences error display, 'development' shows tracebacks
APP_ENV=production

# Site
# NOTE: any value containing spaces MUST be wrapped in double quotes —
# phpdotenv rejects unquoted whitespace and the site will 500 silently
# (the parse error happens before PHP can show errors in the browser).
BASE_URL=https://yourdomain.in
CONTACT_PHONE=+919876543210
CONTACT_PHONE_DISPLAY=+919876543210
CONTACT_WHATSAPP=919876543210
CONTACT_EMAIL=hello@yourdomain.in
CONTACT_LEAD_INBOX=leads@yourdomain.in

# Legal/identity shown on privacy, terms, about, and contact pages.
# These contain spaces, so they MUST be wrapped in double quotes.
LEGAL_ENTITY="Your Company Pvt Ltd"
LEGAL_ADDRESS="123 Example Street, City, State - 560001, India"
LEGAL_GRIEVANCE_OFFICER="Full Name"
LEGAL_JURISDICTION="City, State"

# Database. On shared hosting, create the database/user in the control panel
# and paste those exact values here. src/config/db.php is still supported,
# but it is optional when these values are set.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

# SMTP (Hostinger defaults: smtp.hostinger.com, port 465 SSL or 587 TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=leads@yourdomain.in
SMTP_PASS=your-mailbox-password
SMTP_SECURE=tls
SMTP_FROM=leads@yourdomain.in

# Search-console verification (optional)
GSC_VERIFICATION=
BING_VERIFICATION=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable
# analytics (e.g. local/staging). The tag loads only after the visitor accepts
# the cookie banner.
GA4_MEASUREMENT_ID=

# One-shot deploy helper: set this to a long random string, then visit
# /setup.php?key=THAT_VALUE to install the DB schema and seed the first admin.
# Delete public/setup.php from the server once setup is complete.
SETUP_KEY=
