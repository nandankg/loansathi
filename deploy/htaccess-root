# Root .htaccess for public_html/ when the entire LoanSathi project sits at
# the web root and there's no custom DocumentRoot available (Hostinger Single).
# Routes every request through public/index.php and blocks direct access to
# all non-public folders.

# When someone hits "/", serve through the public folder
DirectoryIndex public/index.php

# Disable directory listing (defense in depth — Hostinger sets this globally too)
Options -Indexes

RewriteEngine On
RewriteBase /

# Block direct access to sensitive folders. Defense in depth — each folder also
# carries its own .htaccess with "Require all denied".
RewriteRule ^(\.git|src|vendor|storage|bin|tests|node_modules|deploy)(/|$) - [F,L]

# Already inside /public/ — don't loop. public/.htaccess takes over from here.
RewriteRule ^public(/|$) - [L]

# Real files at root level (e.g. robots.txt if you ever put one here) — serve as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else, including the bare root path, forwards into /public/.
RewriteRule ^(.*)$ public/$1 [L]

# Hide PHP-Powered-By header
<IfModule mod_headers.c>
  Header unset X-Powered-By
</IfModule>

AddDefaultCharset UTF-8
