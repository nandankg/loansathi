# Root .htaccess for public_html/ when the entire LoanSathi project sits at
# the web root and there's no custom DocumentRoot available (Hostinger Single).
#
# IMPORTANT: do NOT set `DirectoryIndex public/index.php` here — that directive
# is inherited by subdirectories, so when Apache later serves /public/ it would
# look for public/public/index.php (which doesn't exist) and return 403. Rely on
# the server-default DirectoryIndex (index.php) at each level instead.

Options -Indexes

RewriteEngine On
RewriteBase /

# Block direct access to sensitive folders. Defense in depth — each folder also
# carries its own .htaccess with "Require all denied".
RewriteRule ^(\.git|src|vendor|storage|bin|tests|node_modules|deploy)(/|$) - [F,L]

# Already inside /public/ — don't re-rewrite. Apache resolves the file or hands
# off to public/.htaccess from here.
RewriteRule ^public(/|$) - [L]

# Everything else — forward into /public/. For the bare "/" request this becomes
# /public/, which Apache resolves as a directory and serves via its default
# DirectoryIndex (index.php → public_html/public/index.php).
RewriteRule ^(.*)$ public/$1 [L]

# Hide PHP-Powered-By header
<IfModule mod_headers.c>
  Header unset X-Powered-By
</IfModule>

AddDefaultCharset UTF-8
